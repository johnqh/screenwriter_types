{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    // Force `@sudobility/writing_core` to resolve through its real, compiled npm dependency
    // (node_modules) rather than the base tsconfig's own `paths` (the local sibling's raw .ts
    // source, kept there for fast local dev/typecheck): declaring against raw source here would
    // pull writing_core's own huge dependency graph into this package's own declaration output.
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
